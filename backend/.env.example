# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT (JSON Web Token) Security
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" to generate a strong secret
JWT_SECRET=your_jwt_signing_secret_min_32_characters

# Supabase Storage
# Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_never_expose_to_frontend

# Stripe Payments
# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Admin Credentials
ADMIN_EMAIL=admin@example.com
# To generate password hash, run standard bcryptjs hashing.
# Below is a bcrypt hash for password "admin123" (cost factor 10)
# Replace this with your own secure hash.
ADMIN_PASSWORD_HASH=$2a$10$vNIPY1hH/z1tO/XbJc.W8uL5VfE8F/0oV2Lp1c.mS/7rI5D2K6Cki

# Frontend Client Redirections
# CLIENT_URL (Public Store Frontend URL)
CLIENT_URL=http://localhost:5173
# ADMIN_URL (Admin Panel Frontend URL)
ADMIN_URL=http://localhost:5174
